cv_ci_summary <- function(cv_out, scale = c("raw", "scaled")) {
  
  scale <- match.arg(scale)
  
  coef_df <- cv_out$coefficient_each_split
  
  # 不看截距項的 CI，因為截距項不是 MCMC 直接抽出來的
  coef_df <- subset(coef_df, predictor != "(Intercept)")
  
  if (scale == "raw") {
    beta_col <- "beta_raw"
    lower_col <- "CI_lower_raw"
    upper_col <- "CI_upper_raw"
  } else {
    beta_col <- "beta_scaled_median"
    lower_col <- "CI_lower_scaled"
    upper_col <- "CI_upper_scaled"
  }
  
  beta_summary <- aggregate(
    coef_df[, c(beta_col, lower_col, upper_col)],
    by = list(
      method = coef_df$method,
      predictor = coef_df$predictor
    ),
    FUN = function(x) c(mean = mean(x, na.rm = TRUE),
                        sd = sd(x, na.rm = TRUE))
  )
  
  beta_summary <- do.call(data.frame, beta_summary)
  
  selected_summary <- aggregate(
    selected ~ method + predictor,
    data = coef_df,
    FUN = function(x) mean(x, na.rm = TRUE)
  )
  
  names(selected_summary)[names(selected_summary) == "selected"] <- "selection_rate"
  
  result <- merge(
    beta_summary,
    selected_summary,
    by = c("method", "predictor")
  )
  
  return(result)
}
diamond_ci_raw <- cv_ci_summary(diamonds_cv, scale = "raw")
diamond_ci_scaled <- cv_ci_summary(diamonds_cv, scale = "scaled")

diamond_ci_raw
diamond_ci_scaled
