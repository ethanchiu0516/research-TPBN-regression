############################################################
# 0. 套件
############################################################

library(MBSP)
library(MASS)

############################################################
# 1. 產生 X 的 function：p = 100
############################################################

generate_X <- function(n, r1 = 1, r2 = 1, p = 100) {
  
  if (p < 7) {
    stop("p must be at least 7.")
  }
  
  # r1 correlation matrix positive definite condition
  if (abs(r1) >= 1) {
    stop("r1 must be between -1 and 1.")
  }
  
  # r2: 3x3 equicorrelation matrix positive definite condition
  # -1/(3-1) < r2 < 1, so -0.5 < r2 < 1
  if (r2 <= -0.5 || r2 >= 1) {
    stop("r2 must be between -0.5 and 1.")
  }
  
  # X1, X2 ~ N2(0, Sigma12)
  Sigma12 <- matrix(c(1, r1,
                      r1, 1),
                    nrow = 2, byrow = TRUE)
  
  X12 <- MASS::mvrnorm(
    n = n,
    mu = c(0, 0),
    Sigma = Sigma12
  )
  
  # X3, X4, X5 ~ N3(0, Sigma345)
  Sigma345 <- matrix(r2, nrow = 3, ncol = 3)
  diag(Sigma345) <- 1
  
  X345 <- MASS::mvrnorm(
    n = n,
    mu = c(0, 0, 0),
    Sigma = Sigma345
  )
  
  # X6, X7 independent N(0,1)
  X67 <- MASS::mvrnorm(
    n = n,
    mu = c(0, 0),
    Sigma = diag(2)
  )
  
  # X8, ..., X100 independent N(0,1)
  X_noise <- matrix(
    rnorm(n * (p - 7)),
    nrow = n,
    ncol = p - 7
  )
  
  # 合併成 n x p design matrix
  X <- cbind(X12, X345, X67, X_noise)
  colnames(X) <- paste0("X", 1:p)
  
  # 中心化 X
  X <- scale(X, center = TRUE, scale = FALSE)
  
  return(X)
}

############################################################
# 2. 單次模擬 + MBSP fitting：p = 100, q = 2 workaround
############################################################

run_mbsp_once <- function(n = 50,
                          r1 = 0.9,
                          r2 = 0.9,
                          sigma = 1,
                          p = 100,
                          seed = 123,
                          max_steps = 6000,
                          burnin = 5000) {
  
  set.seed(seed)
  
  # true beta: 前 7 個非零，後 93 個為 0
  beta_true <- c(1, 2, -1, -1, 2, 3, -2, rep(0, p - 7))
  
  # 產生 X
  X <- generate_X(n = n, r1 = r1, r2 = r2, p = p)
  
  ############################################################
  # 這裡改成 q = 2
  # 第一個 response 是真正要分析的 y1
  # 第二個 response 是輔助用的 y2，避免 MBSP 在 q=1 時出錯
  ############################################################
  
  q <- 2
  
  beta_true_mat <- cbind(
    beta_true,        # 第一欄：真正的 beta
    rep(0, p)         # 第二欄：輔助 response，全部設為 0
  )
  
  E <- matrix(
    rnorm(n * q, mean = 0, sd = sigma),
    nrow = n,
    ncol = q
  )
  
  Y <- X %*% beta_true_mat + E
  
  colnames(Y) <- c("Y1", "Y2")
  
  # 中心化 Y
  Y <- scale(Y, center = TRUE, scale = FALSE)
  
  ############################################################
  # fit MBSP-TPBN model
  ############################################################
  
  fit <- MBSP(
    Y = Y,
    X = X,
    u = 0.5,
    a = 0.5,
    max_steps = max_steps,
    burnin = burnin,
    save_samples = TRUE,
    model_criteria = FALSE
  )
  
  ############################################################
  # 只取第一個 response 的 beta estimate
  ############################################################
  
  beta_hat <- as.numeric(fit$B_est[, 1])
  
  ci_lower <- as.numeric(fit$B_CI_lower[, 1])
  ci_upper <- as.numeric(fit$B_CI_upper[, 1])
  
  selected_by_CI <- which(ci_lower > 0 | ci_upper < 0)
  
  result_table <- data.frame(
    variable = paste0("X", 1:p),
    beta_true = beta_true,
    beta_hat = beta_hat,
    CI_lower = ci_lower,
    CI_upper = ci_upper,
    selected = 1:p %in% selected_by_CI
  )
  
  mse_beta <- mean((beta_hat - beta_true)^2)
  
  true_active <- which(beta_true != 0)
  
  TP <- sum(selected_by_CI %in% true_active)
  FP <- sum(!(selected_by_CI %in% true_active))
  FN <- sum(!(true_active %in% selected_by_CI))
  TN <- p - TP - FP - FN
  
  performance <- data.frame(
    n = n,
    p = p,
    r1 = r1,
    r2 = r2,
    sigma = sigma,
    MSE_beta = mse_beta,
    TP = TP,
    FP = FP,
    FN = FN,
    TN = TN,
    selected_variables = paste0("X", selected_by_CI, collapse = ", ")
  )
  
  return(list(
    fit = fit,
    X = X,
    Y = Y,
    beta_true = beta_true,
    beta_hat = beta_hat,
    result_table = result_table,
    performance = performance
  ))
}

############################################################
# 3. 執行一次 p = 100 的模擬
############################################################

out <- run_mbsp_once(
  n = 50,
  p = 100,
  r1 = 0.9,
  r2 = 0.9,
  sigma = 1,
  seed = 123,
  max_steps = 6000,
  burnin = 5000
)

# 查看 beta 估計結果
out$result_table

# 查看 performance
out$performance


############################################################
# 4. 多次 replication：p = 100, q = 2 workaround
############################################################

run_mbsp_replications <- function(n = 50,
                                  p = 100,
                                  r1 = 0.9,
                                  r2 = 0.9,
                                  sigma = 1,
                                  n_rep = 100,
                                  max_steps = 6000,
                                  burnin = 5000) {
  
  all_perf <- list()
  all_beta <- list()
  
  for (rep in 1:n_rep) {
    
    cat("Running replication:", rep, "\n")
    
    tmp <- tryCatch({
      run_mbsp_once(
        n = n,
        p = p,
        r1 = r1,
        r2 = r2,
        sigma = sigma,
        seed = 1000 + rep,
        max_steps = max_steps,
        burnin = burnin
      )
    }, error = function(e) {
      message("Error in replication ", rep, ": ", e$message)
      return(NULL)
    })
    
    if (!is.null(tmp)) {
      
      all_perf[[length(all_perf) + 1]] <- data.frame(
        rep = rep,
        tmp$performance
      )
      
      all_beta[[length(all_beta) + 1]] <- data.frame(
        rep = rep,
        j = 1:p,
        variable = paste0("X", 1:p),
        beta_true = tmp$beta_true,
        beta_hat = tmp$beta_hat
      )
    }
  }
  
  if (length(all_beta) == 0) {
    stop("All replications failed. Please check run_mbsp_once().")
  }
  
  perf_df <- do.call(rbind, all_perf)
  beta_df <- do.call(rbind, all_beta)
  
  ############################################################
  # 每一次 replication 的 beta_hat 已經是：
  # 該次 MCMC samples after burn-in 的 posterior median
  #
  # 這裡是在整理 100 次 replication 的結果：
  # mean_median = 100 次 posterior median 的平均
  # sd_median   = 100 次 posterior median 的標準差
  ############################################################
  
  beta_summary <- do.call(rbind, lapply(split(beta_df, beta_df$j), function(df) {
    data.frame(
      j = unique(df$j),
      variable = unique(df$variable),
      beta_true = unique(df$beta_true),
      mean_median = mean(df$beta_hat),
      median_median = median(df$beta_hat),
      sd_median = sd(df$beta_hat)
    )
  }))
  
  rownames(beta_summary) <- NULL
  
  ############################################################
  # performance summary
  ############################################################
  
  performance_summary <- data.frame(
    n_success = nrow(perf_df),
    n_fail = n_rep - nrow(perf_df),
    mean_MSE_beta = mean(perf_df$MSE_beta),
    sd_MSE_beta = sd(perf_df$MSE_beta),
    mean_TP = mean(perf_df$TP),
    mean_FP = mean(perf_df$FP),
    mean_FN = mean(perf_df$FN),
    mean_TN = mean(perf_df$TN)
  )
  
  return(list(
    performance_each_rep = perf_df,
    performance_summary = performance_summary,
    beta_each_rep = beta_df,
    beta_summary = beta_summary
  ))
}

############################################################
# 5. 執行 100 次 replication
############################################################

rep_out <- run_mbsp_replications(
  n = 50,
  p = 100,
  r1 = 0.9,
  r2 = 0.9,
  sigma = 1,
  n_rep = 100,
  max_steps = 6000,
  burnin = 5000
)

rep_out$performance_each_rep
rep_out$beta_summary
